{
  "name": "beds24-sdk-client",
  "version": "1.1.6",
  "description": "Typed wrapper over the Beds24 V2 JSON API — HTTP client, OpenAPI schema validation, and typed domain workflows (bookings, pricing, availability, channels, webhooks, inventory, accounts, properties, organizations, channel actions, reviews, Stripe).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/beds24-mcp",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/jverneuer/beds24-mcp/tree/main/packages/sdk",
  "bugs": {
    "url": "https://github.com/jverneuer/beds24-mcp/issues"
  },
  "keywords": [
    "beds24",
    "api",
    "sdk",
    "openapi",
    "schema-validation",
    "bookings",
    "pricing",
    "availability",
    "channels",
    "webhooks"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./ops": {
      "types": "./dist/ops/index.d.ts",
      "import": "./dist/ops/index.js"
    },
    "./validate": {
      "types": "./dist/schema/validate.d.ts",
      "import": "./dist/schema/validate.js"
    },
    "./schema": {
      "types": "./dist/schema/schema.d.ts",
      "import": "./dist/schema/schema.js"
    },
    "./types": {
      "types": "./dist/generated/types.d.ts",
      "import": "./dist/generated/types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "apiV2.yaml"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/generated && cp src/generated/types.d.ts dist/generated/types.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.7.0"
  }
}
