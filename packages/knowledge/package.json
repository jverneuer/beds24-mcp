{
  "name": "beds24-knowledge",
  "version": "1.1.6",
  "description": "Knowledge processing, vector+FTS indexing, and hybrid search over the Beds24 documentation corpus. libsql + sqlite-vec + local embeddings via @huggingface/transformers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/beds24-mcp",
    "directory": "packages/knowledge"
  },
  "homepage": "https://github.com/jverneuer/beds24-mcp/tree/main/packages/knowledge",
  "bugs": {
    "url": "https://github.com/jverneuer/beds24-mcp/issues"
  },
  "keywords": [
    "beds24",
    "vector-index",
    "semantic-search",
    "hybrid-search",
    "rrf",
    "embeddings",
    "libsql",
    "sqlite-vec",
    "fts5"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "knowledge"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "libsql": "^0.4.0",
    "sqlite-vec": "^0.1.7"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
