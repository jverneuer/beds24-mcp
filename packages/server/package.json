{
  "name": "beds24-mcp-server",
  "version": "1.1.6",
  "description": "MCP server + CLI host for Beds24 — depends on beds24-sdk-client and beds24-knowledge. Published package with the beds24-mcp-server bin.",
  "type": "module",
  "bin": {
    "beds24-mcp-server": "dist/cli.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && bun build src/cli.ts --target node --packages=external --outfile dist/cli.mjs --banner '#!/usr/bin/env node' && chmod +x dist/cli.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/server.ts",
    "index": "bun run src/cli.ts index",
    "reindex": "bun run src/cli.ts index --force",
    "status": "bun run src/cli.ts status",
    "setup": "bun run src/cli.ts setup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "beds24-knowledge": "workspace:*",
    "beds24-sdk-client": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
