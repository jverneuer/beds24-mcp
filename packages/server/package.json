{
  "name": "@jverneuer/beds24-mcp-server",
  "version": "1.2.0",
  "description": "MCP server + CLI host for Beds24. Depends on beds24-sdk-client (typed API client) and beds24-knowledge (hybrid vector+FTS search). Exposes tools, prompts, and resources for an LLM via @modelcontextprotocol/sdk.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/beds24-mcp",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/jverneuer/beds24-mcp/tree/main/packages/server",
  "bugs": {
    "url": "https://github.com/jverneuer/beds24-mcp/issues"
  },
  "keywords": [
    "beds24",
    "mcp",
    "mcp-server",
    "llm",
    "ai",
    "sdk",
    "openapi",
    "schema-validation",
    "semantic-search",
    "vector-index"
  ],
  "type": "module",
  "bin": {
    "beds24-mcp-server": "dist/cli.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && bun build src/cli.ts --target node --packages=external --outfile dist/cli.mjs --banner '#!/usr/bin/env node' && chmod +x dist/cli.mjs",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/server.ts",
    "index": "bun run src/cli.ts index",
    "reindex": "bun run src/cli.ts index --force",
    "status": "bun run src/cli.ts status",
    "setup": "bun run src/cli.ts setup"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@jverneuer/beds24-knowledge": "workspace:*",
    "@jverneuer/beds24-sdk-client": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
