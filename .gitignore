# Ignore everything starting with a dot in root
/.?*
/.* 

# Allow GitHub workflows/config
!.gitignore
!.github/
!.github/**

# Generated vector index (regenerated by `bun run index`)
.beds24/

# Build (regenerated by `bun run build`)
dist/
packages/*/dist/
*.tsbuildinfo

# Stray Bun/TS emit next to source (never commit compiled output)
packages/*/src/*.js
packages/*/src/*.js.map

# Dependencies
node_modules/

# Scratch / local test scripts
qrun.ts

# Local model cache is fine to keep, but ignore if huge
# .cache/

