{
  "name": "beds24-mcp-server",
  "version": "1.1.5",
  "description": "MCP server + CLI + SDK for the Beds24 API — semantic search over cited docs, YAML schema validation, and a dependency-free TS SDK.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/beds24-mcp.git"
  },
  "homepage": "https://github.com/jverneuer/beds24-mcp#readme",
  "bugs": {
    "url": "https://github.com/jverneuer/beds24-mcp/issues"
  },
  "keywords": [
    "beds24",
    "mcp",
    "mcp-server",
    "llm",
    "ai",
    "sdk",
    "openapi",
    "schema-validation",
    "semantic-search",
    "vector-index"
  ],
  "type": "module",
  "bin": {
    "beds24-mcp-server": "dist/cli.mjs"
  },
  "main": "dist/sdk/index.js",
  "exports": {
    ".": "./dist/sdk/index.js",
    "./sdk": "./dist/sdk/index.js",
    "./client": "./dist/sdk/client.js",
    "./ops": "./dist/sdk/ops/index.js",
    "./search": "./dist/sdk/search.js",
    "./validate": "./dist/sdk/validate.js",
    "./schema": "./dist/sdk/schema.js",
    "./indexer": "./dist/sdk/indexer.js",
    "./types": "./dist/sdk/generated/types.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "knowledge",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun run src/server.ts",
    "serve": "bun run src/cli.ts serve",
    "index": "bun run src/cli.ts index",
    "reindex": "bun run src/cli.ts index --force",
    "status": "bun run src/cli.ts status",
    "setup": "bun run src/cli.ts setup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "fetch-spec": "bun run scripts/fetch-spec.ts",
    "generate-types": "bun run scripts/generate-types.ts",
    "prebuild": "bun run fetch-spec && bun run generate-types",
    "build": "bun build src/cli.ts --target node --packages=external --outfile dist/cli.mjs --banner '#!/usr/bin/env node' && chmod +x dist/cli.mjs && bun build src/sdk/index.ts src/sdk/beds24.ts src/sdk/client.ts src/sdk/ops/index.ts src/sdk/search.ts src/sdk/validate.ts src/sdk/schema.ts src/sdk/indexer.ts --target node --packages=external --outdir dist/sdk --sourcemap && mkdir -p dist/sdk/generated && cp src/sdk/generated/types.d.ts dist/sdk/generated/types.d.ts",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "libsql": "^0.4.0",
    "openapi-fetch": "^0.17.0",
    "sqlite-vec": "^0.1.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "bun-types": "^1.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0"
  }
}
