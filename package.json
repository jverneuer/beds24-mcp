{
  "name": "beds24-mcp",
  "version": "1.1.5",
  "private": true,
  "description": "MCP server + CLI + SDK for the Beds24 API — semantic search over cited docs, YAML schema validation, and a typed V2 SDK. npm-workspace monorepo (sdk / knowledge / server).",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/beds24-mcp.git"
  },
  "homepage": "https://github.com/jverneuer/beds24-mcp#readme",
  "bugs": {
    "url": "https://github.com/jverneuer/beds24-mcp/issues"
  },
  "keywords": [
    "beds24",
    "mcp",
    "mcp-server",
    "llm",
    "ai",
    "sdk",
    "openapi",
    "schema-validation",
    "semantic-search",
    "vector-index"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "bun run packages/server/src/server.ts",
    "serve": "bun run packages/server/src/cli.ts serve",
    "index": "bun run packages/server/src/cli.ts index",
    "reindex": "bun run packages/server/src/cli.ts index --force",
    "status": "bun run packages/server/src/cli.ts status",
    "setup": "bun run packages/server/src/cli.ts setup",
    "typecheck": "tsc --noEmit -p packages/sdk/tsconfig.json && tsc --noEmit -p packages/knowledge/tsconfig.json && tsc --noEmit -p packages/server/tsconfig.json",
    "test": "bun test --isolate",
    "changeset": "changeset",
    "fetch-spec": "bun run scripts/fetch-spec.ts",
    "generate-types": "bun run scripts/generate-types.ts",
    "add-frontmatter": "bun run scripts/add-frontmatter.ts",
    "prebuild": "bun run fetch-spec && bun run generate-types",
    "build": "bun run build:sdk && bun run build:knowledge && bun run build:server",
    "build:sdk": "bun run --cwd packages/sdk build",
    "build:knowledge": "bun run --cwd packages/knowledge build",
    "build:server": "bun run --cwd packages/server build",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.0",
    "@modelcontextprotocol/sdk": "^1.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@jverneuer/beds24-knowledge": "workspace:*",
    "@jverneuer/beds24-sdk-client": "workspace:*",
    "js-yaml": "^4.1.0",
    "libsql": "^0.4.0",
    "sqlite-vec": "^0.1.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "bun-types": "^1.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.0"
  }
}
