{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "zod": ["./node_modules/.bun/zod@4.4.3/node_modules/zod/v4"],
      "zod/*": ["./node_modules/.bun/zod@4.4.3/node_modules/zod/v4/*"],
      "beds24-knowledge": ["./packages/knowledge/src/index.ts"],
      "beds24-knowledge/*": ["./packages/knowledge/src/*"],
      "beds24-sdk-client": ["./packages/sdk/src/index.ts"],
      "beds24-sdk-client/*": ["./packages/sdk/src/*"]
    },
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".beds24", "packages/*/dist"]
}
